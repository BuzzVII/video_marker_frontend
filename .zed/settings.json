{
  "formatter": "language_server",
  "format_on_save": "on",
  "tab_size": 2,
  "language_overrides": {
    "TypeScript": {
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "TSX": {
      "formatter": "language_server",
      "format_on_save": "on"
    }
  },
  "lsp": {
    "typescript-language-server": {
      "settings": {
        "typescript": {
          "preferences": {
            "includePackageJsonAutoImports": "on"
          }
        }
      }
    }
  }
}
